# Example environment for the khedmaPro React Native app (Expo SDK 57).
#
# Copy to `.env` (never commit the real one):
#   cp .env.example .env
# Expo exposes EXPO_PUBLIC_* variables to the app bundle at build time via
# react-native-dotenv; the backend must be reachable from the device/emulator
# (use your LAN IP, not localhost, for real-device testing).

# REQUIRED — base URL of the khedmaPro backend, no trailing slash.
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001

# Metro bundler reachability for Expo Go on a real device (Docker/Linux):
# EXPO_PACKAGER_HOSTNAME=192.168.1.42
