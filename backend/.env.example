# Example environment for the khedmaPro backend.
#
# Copy to `.env` (never commit the real one):
#   cp .env.example .env
# Every variable has a baked-in default in config.py except the ones marked
# REQUIRED. docker-compose.yml references ${JWT_SECRET:?...}, so `docker
# compose up` fails with a clear message until JWT_SECRET is set.

# ---- Core ----
# Mongo connection used by the server AND the test helpers (tests/helpers.py).
MONGO_URL=mongodb://localhost:27017
DB_NAME=khedmapro
# REQUIRED — signs every session token. 32+ random characters; anything
# shorter (or a placeholder like change-me/local-dev-*) refuses to start
# when APP_ENV=production. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-secret-value-32chars
# Session lifetime in minutes (default 720 = 12 h).
JWT_EXPIRE_MINUTES=720
# development | test | production. production fails closed on weak config
# (mock payments, mock SMS, dev seed, placeholder JWT/push keys).
APP_ENV=development
# Comma-separated browser origins allowed to call the API (Bearer tokens
# only — credentials are never echoed).
CORS_ORIGINS=http://localhost:8081,http://localhost:8001
# Public base URL the app uses to build Chargily checkout URLs.
API_PUBLIC_URL=http://localhost:8001
APP_RETURN_URL=khedmapro://payment-return

# ---- Realtime (P27) ----
# Set to a Redis instance to fan out WebSocket chat across gunicorn workers.
# No value = single-process in-memory delivery.
REDIS_URL=redis://localhost:6379

# ---- Payments (Chargily) ----
CHARGILY_MODE=test
CHARGILY_SECRET_KEY=
CHARGILY_WEBHOOK_SECRET=
# Mock payment fallback for /subscription/pay. Only honored in
# development/test AND when explicitly "true"; production refuses to start.
ALLOW_MOCK_PAYMENTS=false

# ---- SMS ----
# mock | twilio | http. production refuses "mock".
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# HTTP gateway (JSON): {"url": "...", "method": "POST", "headers": {...},
# "body_template": "..."} — headers often carry API keys, so this is env-only.
SMS_HTTP_HEADERS=

# ---- Push ----
# Emergent push relay key. "placeholder" logs ERROR at startup and in
# production refuses to start.
EMERGENT_PUSH_KEY=placeholder

# ---- File storage (P24) ----
# Local filesystem backend when S3_* is unset. Contents are gitignored.
FILE_STORAGE_DIR=.khedmapro_files
# S3-compatible object storage for ID documents and portfolio images:
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base for portfolio URLs (leave empty to serve via the API instead).
S3_PUBLIC_BASE=
# Admin signed-URL lifetime for private verification documents (seconds).
VERIFICATION_URL_TTL=300

# ---- Jobs / guards ----
VERIFICATION_DOCS_RETENTION_DAYS=90
REPORTS_AUTO_FLAG_THRESHOLD=3
REPORT_WINDOW_DAYS=30

# ---- Rate limits (per window) ----
RATE_LIMIT_LOGIN_IP=60
RATE_LIMIT_OTP_IP=60
RATE_LIMIT_GUEST_BOOKING_IP=20
RATE_LIMIT_MESSAGE_USER=60
RATE_LIMIT_PUSH_USER=30
RATE_LIMIT_REPORT_USER=10

# ---- Mobile app ----
EXPO_PUBLIC_BACKEND_URL=http://localhost:8001
